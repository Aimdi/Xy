# Threads / Instagram credentials (optional — only needed for authenticated endpoints)
THREADS_USERNAME=
THREADS_PASSWORD=
THREADS_TOKEN=
THREADS_DEVICE_ID=
THREADS_USER_ID=

# Local HTTP server (Raspberry Pi / systemd)
XY_HOST=127.0.0.1
XY_PORT=8787
XY_VERBOSE=0
XY_DOC_ID_CACHE=.xy-doc-ids.json

# Set to 1 to enable live network tests
XY_LIVE_TESTS=0
