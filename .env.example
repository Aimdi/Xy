# Threads / Instagram credentials (optional — only needed for authenticated endpoints)
THREADS_USERNAME=
THREADS_PASSWORD=
THREADS_TOKEN=
THREADS_DEVICE_ID=
THREADS_USER_ID=

# Local HTTP server (Raspberry Pi / systemd / Coolify)
# Coolify: use XY_HOST=0.0.0.0 and set Ports Exposes to PORT/XY_PORT (default 8787).
XY_HOST=127.0.0.1
XY_PORT=8787
# PORT=8787
XY_API_TOKEN=
XY_TRANSPORT=curl
XY_VERBOSE=0
XY_DOC_ID_CACHE=.xy-doc-ids.json
# Netscape cookie jar for EU consent cookies (datr/mid/ig_did/csrftoken).
# Coolify: put both caches on a persistent volume, e.g. /data/...
XY_COOKIE_JAR=.xy-cookies.txt
# US egress proxy if EU cookie jar alone is not enough:
# XY_PROXY=http://user:pass@proxy-host:port

# Set to 1 to enable live network tests
XY_LIVE_TESTS=0
